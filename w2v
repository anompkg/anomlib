#!/bin/sh

# bug
# if default value of buffer equale to value of first line
# then the line be omitted...

# fix
# we can print first line if buffer nonchanged

w2v() {
  local w2v_line w2v_buffer changed

  # remove all clone lines
  while read w2v_line; do

    # dont print the line again
    # print only one from the clones,origin
    if [[ "y" != "$changed" || "$w2v_buffer" != "$w2v_line" ]]; then
      echo "$w2v_line"
    fi

    w2v_buffer="$w2v_line"

    # "buffer changed?"
    changed="y"
  done
}

w2v "$@"
