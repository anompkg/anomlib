#!/bin/sh


mkdir -p ~/.cache/dowith
dowithCache="${dowithCache-$HOME/.cache/dowith}"
dowithLog="${dowithLog-$dowithCache/dowith.log}"


dowith_input() {
    # read a command, but we use readline wrapper :D
    rlwrap -pYellow -S '% ' -H "$dowithCache/$*.histfile" -o cat
}

# run commands (as arguments) in a command in interactive (loop) mode
dowith() {

    local interpretor="$@"
    local status

    # public
    local welcomeMSG="% "

    echo -en "$welcomeMSG"

    # run input-command in a interpretor with args
    while Command=$(dowith_input "$@"); do

	if [[ "$Command" == "exit" ]]; then
	    break
	fi

	# log this command in temp hitstory file
	echo "$interpretor $Command" >> "$dowithLog"
	
	# run command in interpretor
	$interpretor $Command

	# keep returned error-code
	status=$?

	echo -en "$welcomeMSG"

    done

    echo "$0: exiting '$@'"
}

# Run this function as application
dowith "$@"


