#!/bin/sh

# bug
# if default value of buffer equale to value of first line
# then the line be omitted...

# fix
# we can print first line if buffer nonchanged

w2v() {
    local buffer

    # Clean Doublicate lines
    while read line; do

	# Print common line only once
	if [[ "$buffer" != "$line" ]]; then
	    echo "$line"
	fi

	# Store previous line, so we can check if next is clone or not
	buffer="$line"
    done
}


file="${1-/dev/stdin}"

cat "$file" | w2v

