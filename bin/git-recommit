#!/bin/sh

# Get 1st 7 symbols from git commit hash
gitShortCommit(){
    local commitHash="$1"

    printf "$commitHash" | cut -c1-7
}


gitRecommit(){
    local commitHash="$1"

    local shortCom=`gitShortCommit "$commitHash"`
    
    # change TODO: sed -i
    GIT_EDITOR="sed 's/^pick $shortCom /edit $shortCom /g' -i" git rebase -i "${commitHash}^"
    git reset "${commitHash}^"
}

gitRecommit "$@"
