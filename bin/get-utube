#!/usr/bin/env bash

UTUBE="${UTUBE:-yt-dlp}"
SUBS="${SUBS:-en.*,cs.*,uk.*,ru.*}"
UTUBE_HOME="${UTUBE_HOME:-$HOME/Videos/yt}"
KEYS="${KEYS:-list}"

# common Errors
err={err:-2}

keys=(srt auto-subs z)

if [[ -n ${KEYS:-} ]]; then
  IFS=',' read -r -a extra_keys <<< "$KEYS"
  keys+=("${extra_keys[@]}")
fi


scream() {
    echo "FATAL: $@" >&2
    echo "exit code: $err" >&2
    return $err
}

die() {
  scream "$@"
  exit $err
}


# Handle special cases
for key in "${keys[@]}"; do
  case "$key" in
    no-dl)
        set -- --skip-download "$@"
        ;;
    list)
        set -- --sub-langs "$SUBS" "$@"
        ;;
    all)
        set -- --sub-langs all "$@"
        ;;
    auto-subs)
        set -- --write-subs --write-auto-subs "$@"
        ;;
    srt)
        set -- --convert-subs srt "$@"
        ;;
    *)
        scream "Unknown key: '$key' in $KEYS"
        scream "args where we left off: $@"
        die
        ;;
  esac
done

echo "KEYS: $KEYS"
echo "args: $@"
echo "sh args: $BASH_ARGV"
echo "sh args: $BASH_ARGV0"

mkdir -p "$UTUBE_HOME" || exit 1
cd "$UTUBE_HOME" || exit 1

exec "$UTUBE" \
  --socket-timeout 10 \
  --retries 2 \
  --extractor-retries 2 \
  "$@"
