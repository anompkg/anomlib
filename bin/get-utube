#!/usr/bin/env bash

IFS=',' read -r -a keys <<< "$KEYS"

# Handle special cases
for key in "${keys[@]}"; do
  case "$key" in
    nodl)
        set -- --skip-download "$@"
        ;;
    selected)
        set -- --sub-langs "$UTUBE_SUBS" "$@"
        ;;
    all)
        set -- --sub-langs all "$@"
        ;;
    *)
        echo "Unknown key: $key"
        # die "SUBS must be 'selected' or 'all' not: $SUBS"
        ;;
  esac
done

keys=(x y z)

if [[ -n ${KEYS:-} ]]; then
  IFS=',' read -r -a extra_keys <<< "$KEYS"
  keys+=("${extra_keys[@]}")
fi


UTUBE="${UTUBE:-yt-dlp}"
UTUBE_SUBS="${UTUBE_SUBS:-en.*,cs.*,uk.*,ru.*}"
UTUBE_HOME="${UTUBE_HOME:-$HOME/Videos/yt}"
SUBS="${SUBS:-selected}"

# commons
err={err:-2}

scream() {
    printf "%s\n" "$*" >&2
    return $err
}

die() {
    printf "FATAL: %s\n" "$*" >&2
    exit $err
}

case "$SUBS" in
  selected)
    set -- --sub-langs "$UTUBE_SUBS" "$@"
    ;;
  all)
    set -- --sub-langs all "$@"
    ;;
  *)
    die "SUBS must be 'selected' or 'all' not: $SUBS"
    ;;
esac

mkdir -p "$UTUBE_HOME" || exit 1
cd "$UTUBE_HOME" || exit 1

exec "$UTUBE" \
  --write-subs \
  --write-auto-subs \
  --convert-subs srt \
  --socket-timeout 10 \
  --retries 2 \
  --extractor-retries 2 \
  "$@"
